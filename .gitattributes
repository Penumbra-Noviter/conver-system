# Auto-detect text files and normalize to LF
* text=auto

# Python source
*.py text diff=python

# Markdown / docs
*.md text
*.txt text

# Frontend
*.html text
*.css text
*.js text
# ESM 脚本：保 shebang 可执行 + esbuild/vitest 直 import 不因 CRLF 崩溃
*.mjs text eol=lf

# Config
*.json text
*.toml text
*.yaml text
*.yml text
*.example text

# Denylist — binary files
*.db binary
*.sqlite binary
*.png binary
*.ico binary
