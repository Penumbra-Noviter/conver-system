<?xml version="1.0" encoding="utf-8"?>
<!-- M5 模拟器明文回环（F-M5-02 必办，spec §3-9 / 共识 D6）：
     App 内本地 HTTP 托管（dart:io HttpServer）监听 127.0.0.1:8642，WebView
     以普通 http 源加载游戏——targetSdk >= 28 默认拦截明文（WebView 遵循本
     配置），须仅对回环放行明文。

     明确域（base-config）不放行：除 127.0.0.1 / localhost 之外的任何域名
     （含同网段 LAN IP 与公网）明文 http 一律被拦——明文面收缩到回环。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>