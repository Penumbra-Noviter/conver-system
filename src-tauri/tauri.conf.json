{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Conver System",
  "version": "0.1.0",
  "identifier": "com.conversystem.app",
  "mainBinaryName": "conver-system",
  "build": {
    "frontendDist": "boot"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Conver System — 角色对话",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "url": "boot.html"
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["../dist/conver_backend"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
